# Sanity Headless CMS
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01
# Optional for public published datasets; required if dataset is private
SANITY_API_READ_TOKEN=
# Required only when running scripts/migrate-to-sanity.mjs
SANITY_API_WRITE_TOKEN=

# On-Demand Revalidation & Vercel ISR
REVALIDATE_SECRET=change_me_to_a_long_random_secret
VERCEL_ISR_BYPASS_TOKEN=change_me_to_a_long_random_secret_min_32_chars

# Site URL
SITE_URL=https://www.buildwithtausif.in
