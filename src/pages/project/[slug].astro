---
import "@styles/global.css";
import PostLayout from "@layouts/postLayout.astro";
import BlogLayout from "@layouts/blogLayout.astro";
import UpsideDown from "@components/UpsideDown.astro";
import ReadingProgressBar from "@components/ReadingProgressBar.astro";
import TableOfContents from "@components/TableOfContents.astro";
import TldrBox from "@components/TldrBox.astro";
import MediaLightbox from "@components/MediaLightbox.astro";
import ArticleFooter from "@components/ArticleFooter.astro";
import BlockRenderer from "@components/cms/BlockRenderer.astro";
import { getProjectBySlug } from "@lib/cms/queries";
import { parsePortableBody } from "@lib/cms/portableText";
import { resolveCmsSeo } from "@utils/seoConfig";
import { setEdgeCacheHeaders } from "@utils/cache";
import countReadingMinutes from "@utils/readingMin";
import formatRelativeTime from "@utils/relativeTime";

export const prerender = false;

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
  Astro.response.status = 404;
} else {
  setEdgeCacheHeaders(Astro.response.headers);
}

const parsed = project ? parsePortableBody(project.body) : { segments: [], headings: [], wordCount: 0 };
const readTime = project
  ? project.readTimeMinutes || Math.max(1, countReadingMinutes(parsed.wordCount))
  : 0;
const relativeDate = project ? formatRelativeTime(project.pubDate) : "";

const seo = project
  ? resolveCmsSeo(
      Astro.url.pathname,
      {
        title: `${project.title} – Technical Case Study`,
        desc: project.description,
        keywords: project.tags.join(", "),
        type: "article",
      },
      project.seo,
      project.updatedAt
    )
  : null;
---

{!project || !seo ? (
  <BlogLayout
    title="404 - Not Found | buildwithtausif"
    desc="Friends don't lie. But this link did... the page you're looking for is nowhere to be found."
    noIndex={true}
  >
    <UpsideDown type="404" />
  </BlogLayout>
) : (
  <PostLayout
    title={seo.title}
    desc={seo.desc}
    keywords={seo.keywords}
    imageUrl={seo.imageUrl}
    imageAlt={seo.imageAlt}
    type={seo.type || "article"}
    canonicalUrl={seo.canonicalUrl}
    noIndex={seo.noIndex}
    twitterCard={seo.twitterCard}
    publishedTime={project.pubDate.toISOString()}
    modifiedTime={project.updatedAt}
  >
    <ReadingProgressBar totalMinutes={readTime} />
    <MediaLightbox />

    <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans text-neutral-100">
      {/* Breadcrumb Bar */}
      <nav class="breadcrumb-nav flex items-center gap-2 text-xs font-mono text-zinc-400 mb-6 flex-wrap">
        <a href="/" class="hover:text-lime-400 transition-colors">[H] HOME</a>
        <span class="text-zinc-600">/</span>
        <a href="/projects" class="hover:text-lime-400 transition-colors">PROJECTS</a>
        <span class="text-zinc-600">/</span>
        <span class="text-zinc-400 truncate max-w-[200px] sm:max-w-sm">
          {project.title}
        </span>
      </nav>

      {/* Project Hero Header Card */}
      <header class="max-w-4xl mx-auto mb-10 bg-zinc-950/80 border border-zinc-800 p-6 sm:p-10 rounded-xl relative overflow-hidden shadow-2xl">
        {/* Background Ambient Glow */}
        <div
          class="absolute -right-16 -top-16 w-56 h-56 bg-lime-400/10 blur-3xl rounded-full pointer-events-none"
        >
        </div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            {/* Tag Pills & Version */}
            <div class="flex flex-wrap items-center gap-2 mb-4">
              {project.tags.map((tag: string) => (
                <span class="inline-flex items-center rounded-xs bg-zinc-900 border border-zinc-800 px-2.5 py-1 text-[11px] font-mono font-bold text-lime-400 uppercase tracking-widest">
                  #{tag}
                </span>
              ))}
              {project.version && (
                <span class="inline-flex items-center rounded-xs bg-lime-400/10 px-2 py-0.5 text-[11px] font-mono font-bold text-lime-400 border border-lime-400/30">
                  v{project.version}
                </span>
              )}
            </div>

            {/* Main Title */}
            <h1 class="text-3xl sm:text-5xl font-extrabold text-neutral-100 tracking-tight leading-[1.12] mb-4 font-sans">
              {project.title}
            </h1>

            {/* Tagline */}
            <p class="text-base sm:text-lg text-neutral-400 max-w-2xl leading-relaxed m-0 font-sans">
              {project.description}
            </p>
          </div>

          {/* Action / Metadata Side */}
          <div class="article-meta-strip flex flex-row flex-wrap md:flex-col gap-3 items-start md:items-end shrink-0 pt-2 border-t md:border-t-0 border-zinc-800">
            <div class="flex items-center gap-2.5">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 bg-zinc-900 border border-lime-400/50 text-lime-400 hover:bg-lime-400 hover:text-stone-950 font-mono font-bold px-3.5 py-2 rounded-sm transition-colors text-xs"
                >
                  LIVE DEMO ↗
                </a>
              )}
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-neutral-100 text-stone-950 hover:bg-lime-400 font-mono font-bold px-4 py-2 rounded-sm transition-colors text-xs"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                  VIEW SOURCE
                </a>
              )}
            </div>

            <div class="flex flex-col gap-1 text-xs text-zinc-400 font-mono text-left md:text-right">
              <span>
                {project.pubDate.toLocaleDateString("en-US", {
                  month: "short",
                  year: "numeric",
                })}
                <span class="text-lime-400/90 ml-1">({relativeDate})</span>
              </span>
              <span class="text-zinc-500">
                {readTime} MIN READ
              </span>
            </div>
          </div>
        </div>
      </header>

      {/* Reading Content Grid (Desktop: Center Reading Column + Sticky Right TOC) */}
      <div class="reading-content-grid flex flex-col lg:flex-row items-start justify-center gap-8 lg:gap-12 max-w-6xl mx-auto">
        
        {/* Primary Reading Center Column */}
        <div class="reading-column w-full max-w-3xl min-w-0">
          {/* TL;DR Executive Summary */}
          <TldrBox
            summary={project.description}
            takeaways={project.tldrTakeaways}
            tags={project.tags}
          />

          {/* In-Article Table of Contents (Strictly Mobile/Tablet only, hidden on lg+) */}
          <TableOfContents headings={parsed.headings} variant="mobile" />

          {/* Zen Body Prose */}
          <article class="content w-full prose prose-invert prose-zinc max-w-none text-zinc-300 text-base sm:text-[17px] leading-relaxed font-sans prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-neutral-100 prose-a:text-lime-400 prose-a:no-underline hover:prose-a:underline prose-code:text-lime-300">
            <BlockRenderer segments={parsed.segments} />
          </article>

          {/* Project Milestone Footer */}
          <ArticleFooter currentTitle={project.title} type="project" />
        </div>

        {/* Desktop Sticky Table of Contents (Strictly Desktop lg+ only, hidden on mobile) */}
        <TableOfContents headings={parsed.headings} variant="desktop" />
      </div>
    </main>
  </PostLayout>
)}
