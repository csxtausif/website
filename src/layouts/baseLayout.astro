---
import { getSEOForPath } from "@utils/seoConfig";
const seo = getSEOForPath(Astro.url.pathname);
import pfp from "@res/images/pfp.webp";
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro'
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Tausif Alam",
  gender: "Male",
  jobTitle: "Software Engineer",
  hasOccupation: [
    {
      "@type": "Occupation",
      name: "Software Engineer",
    },
    {
      "@type": "Occupation",
      name: "DevOps Engineer",
    },
    {
      "@type": "Occupation",
      name: "Backend Engineer",
    }
  ],
  url: "https://buildwithtausif.in",
  description: `${seo.desc}`,
  sameAs: [
    "https://github.com/csxtausif",
    "https://www.linkedin.com/in/buildwithtausif/",
    "https://x.com/csxtausif",
    "https://csxtausif.vercel.app",
    "https://www.instagram.com/csxtausif/"
  ],
  alternateName: ["tausif alam", "buildwithtausif", "tausif", "csxtausif"],
  nationality: "Indian",
  knowsLanguage: "English, Hindi",
  knowsAbout: [
    ""
  ],
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Vivekananda Institute of Professional Studies",
      sameAs: "https://vips.edu/",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Guru Gobind Singh Indraprastha University",
      sameAs: "https://ipu.ac.in/",
    },
  ],
  image: `${Astro.props.url}${pfp.src}`,
};
---
<Analytics/>
<!-- Google Tag Manager -->
<script is:inline>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != "dataLayer" ? "&l=" + l : "";
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, "script", "dataLayer", "GTM-5J5KDXHK");
</script>
<!-- End Google Tag Manager -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(personSchema)}
  is:inline
/>
<!-- favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="preload" as="image" href="/preloader.svg" />
<ClientRouter />
