---
import { Zap } from "lucide-react";

interface Props {
  summary: string;
  takeaways?: string[];
  tags?: string[];
  class?: string;
}

const { summary, takeaways = [], tags = [], class: className = "" } = Astro.props;
---

<div
  class={`tldr-box relative rounded-md border border-lime-400/25 bg-zinc-950/70 p-5 sm:p-6 my-8 font-sans shadow-lg ${className}`}
>
  <!-- Subtle decorative ambient glow -->
  <div
    class="absolute -right-8 -top-8 w-24 h-24 bg-lime-400/5 blur-2xl rounded-full pointer-events-none"
  >
  </div>

  <!-- Header -->
  <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-800">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-5 h-5 rounded-xs bg-lime-400 text-stone-950">
        <Zap size={12} className="fill-stone-950 text-stone-950" />
      </span>
      <h2 class="text-xs font-mono font-bold text-lime-400 uppercase tracking-wider m-0">
        [TL;DR] Executive Summary
      </h2>
    </div>
    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest hidden sm:inline">
      Quick Debrief
    </span>
  </div>

  <!-- Summary Text -->
  <p class="text-sm sm:text-[15px] text-zinc-300 leading-relaxed m-0 font-normal">
    {summary}
  </p>

  <!-- Optional Bullet Points -->
  {
    takeaways.length > 0 && (
      <ul class="mt-3.5 space-y-1.5 pl-4 list-disc text-xs sm:text-sm text-zinc-400 font-normal">
        {takeaways.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }

  <!-- Optional Tags/Tech Stack -->
  {
    tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-zinc-800/80">
        <span class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider">
          Focus:
        </span>
        {tags.map((tag) => (
          <span class="inline-flex items-center rounded-xs bg-zinc-900 px-2 py-0.5 text-[10px] font-mono text-zinc-300 border border-zinc-800 uppercase tracking-wider">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</div>
