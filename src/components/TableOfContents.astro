---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "mobile" | "desktop";
  class?: string;
}

const { headings = [], variant = "desktop", class: className = "" } = Astro.props;

// Filter out top-level h1 if it duplicates the article title or depth > 3 to keep TOC clean
const filteredHeadings = headings.filter(
  (h) => h.depth <= 3 && h.text.trim().length > 0
);
---

{
  filteredHeadings.length > 0 && (
    <>
      {variant === "mobile" && (
        /* In-Article Mobile Accordion TOC (Hidden on desktop lg+) */
        <div class={`toc-mobile block lg:hidden w-full my-6 ${className}`}>
          <details class="group rounded-sm border border-zinc-800 bg-zinc-950/70 overflow-hidden shadow-md">
            <summary class="flex items-center justify-between px-4 py-3 cursor-pointer bg-zinc-900/80 hover:bg-zinc-900 border-b border-zinc-800/80 transition-colors select-none">
              <div class="flex items-center gap-2">
                <span class="text-lime-400 font-mono font-bold text-xs uppercase tracking-wider">
                  / Table of Contents
                </span>
                <span class="text-[11px] font-mono text-zinc-500">
                  ({filteredHeadings.length} sections)
                </span>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-zinc-400 transition-transform duration-200 group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>

            <nav class="p-4 bg-zinc-950/90 max-h-72 overflow-y-auto no-scrollbar">
              <ul class="space-y-2 font-mono text-xs">
                {filteredHeadings.map((heading) => (
                  <li
                    class={
                      heading.depth === 3
                        ? "ml-4 text-zinc-400 hover:text-lime-400"
                        : "text-zinc-300 font-medium hover:text-lime-400"
                    }
                  >
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link block py-1 transition-colors truncate"
                      data-slug={heading.slug}
                    >
                      <span class="text-lime-400/60 mr-1.5">
                        {heading.depth === 3 ? "›" : "•"}
                      </span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      )}

      {variant === "desktop" && (
        /* Desktop Sticky Sidebar TOC (Strictly Sticky on Scroll for lg+) */
        <aside
          class={`toc-desktop hidden lg:block w-64 shrink-0 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto no-scrollbar pr-2 ${className}`}
        >
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-zinc-800">
            <span class="text-lime-400 font-mono font-bold text-xs uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
              / On This Page
            </span>
            <span class="text-[10px] font-mono text-zinc-500">
              {filteredHeadings.length} SECTIONS
            </span>
          </div>

          <nav class="border-l border-zinc-800/80">
            <ul class="space-y-1 font-mono text-xs">
              {filteredHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class={`toc-link block py-1.5 pl-3 border-l-2 -ml-px border-transparent text-zinc-400 hover:text-zinc-200 hover:border-zinc-500 transition-all leading-normal ${
                      heading.depth === 3 ? "ml-2.5 text-[11px] text-zinc-500" : ""
                    }`}
                    data-slug={heading.slug}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </>
  )
}

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  function setupTocScrollSpy() {
    const tocLinks = document.querySelectorAll(".toc-link");
    if (!tocLinks.length) return;

    const headings = Array.from(tocLinks)
      .map((link) => {
        const slug = link.getAttribute("data-slug");
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (!headings.length) return;

    let activeSlug = "";

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activeSlug = entry.target.id;
          }
        });

        if (!activeSlug && headings[0]) {
          activeSlug = headings[0].id;
        }

        tocLinks.forEach((link) => {
          const slug = link.getAttribute("data-slug");
          if (slug === activeSlug) {
            link.classList.add(
              "text-lime-400",
              "border-lime-400",
              "font-semibold",
              "bg-lime-400/5"
            );
            link.classList.remove("text-zinc-400", "text-zinc-500", "border-transparent");
          } else {
            link.classList.remove(
              "text-lime-400",
              "border-lime-400",
              "font-semibold",
              "bg-lime-400/5"
            );
            link.classList.add("border-transparent");
          }
        });
      },
      {
        rootMargin: "0px 0px -65% 0px",
        threshold: 0.1,
      }
    );

    headings.forEach((heading) => observer.observe(heading));

    // Smooth scroll handling for clicking TOC items with offset
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (!href || !href.startsWith("#")) return;
        const target = document.getElementById(href.slice(1));
        if (target) {
          e.preventDefault();
          const targetPosition =
            target.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({
            top: targetPosition,
            behavior: "smooth",
          });
          history.pushState(null, "", href);
        }
      });
    });
  }

  // Bind on both initial load and Astro view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTocScrollSpy);
  } else {
    setupTocScrollSpy();
  }
  document.addEventListener("astro:page-load", setupTocScrollSpy);
</script>
