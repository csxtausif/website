---
import { ArrowUpRight } from "lucide-react";

interface Props {
  url: string;
  label: string;
  description?: string;
  badge?: string;
}

const { url, label, description, badge } = Astro.props;
const isExternal = /^https?:\/\//i.test(url);
---

<a
  href={url}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class="not-prose group my-6 flex items-center justify-between gap-4 rounded-lg border border-zinc-800 bg-zinc-950/70 p-4 sm:p-5 hover:border-lime-400/50 hover:bg-zinc-900/60 transition-all duration-200 shadow-lg"
>
  <div class="min-w-0">
    <div class="flex items-center gap-2 mb-1">
      {badge && (
        <span class="inline-flex items-center rounded-xs bg-lime-400/10 px-2 py-0.5 text-[10px] font-mono font-bold text-lime-400 border border-lime-400/30 uppercase tracking-wider">
          {badge}
        </span>
      )}
      <span class="text-[11px] font-mono text-zinc-500 truncate">{url}</span>
    </div>
    <h4 class="text-sm sm:text-base font-bold text-neutral-100 group-hover:text-lime-400 transition-colors m-0 truncate">
      {label}
    </h4>
    {description && (
      <p class="text-xs text-zinc-400 mt-1 m-0 line-clamp-2 font-sans leading-relaxed">
        {description}
      </p>
    )}
  </div>
  <div class="shrink-0 p-2 rounded-sm bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover:text-lime-400 group-hover:border-lime-400/40 transition-colors">
    <ArrowUpRight size={16} />
  </div>
</a>
