---
import { Image } from "astro:assets";
import { LayoutGrid } from "lucide-react";
import type { ImageMetadata } from "astro";

export interface BentoItem {
  src: ImageMetadata | string;
  fullSrc?: string;
  alt?: string;
  title?: string;
  caption?: string;
  span?: "normal" | "wide" | "tall" | "large";
}

interface Props {
  images: (ImageMetadata | string | BentoItem)[];
  title?: string;
  description?: string;
  class?: string;
}

const {
  images = [],
  title = "Visual Archive",
  description,
  class: className = "",
} = Astro.props;

// Normalize images into BentoItem objects
const items: BentoItem[] = images.map((img, idx) => {
  if (typeof img === "object" && img !== null && "src" in img && !("format" in img)) {
    return img as BentoItem;
  }
  return {
    src: img as ImageMetadata | string,
    alt: `Figure ${String(idx + 1).padStart(2, "0")}`,
  };
});

// Interlocking 3-column dense bento pattern
const getBentoSpanClass = (item: BentoItem, index: number) => {
  if (item.span) {
    switch (item.span) {
      case "large":
        return "col-span-1 sm:col-span-2 row-span-2";
      case "wide":
        return "col-span-1 sm:col-span-2 row-span-1";
      case "tall":
        return "col-span-1 row-span-2";
      default:
        return "col-span-1 row-span-1";
    }
  }

  // Interlocking 3-column repeating pattern: 2+1=3, 1+2=3, 1+1+1=3
  const mod = index % 9;
  switch (mod) {
    case 0:
      return "col-span-1 sm:col-span-2 row-span-2"; // 2x2 Large
    case 1:
      return "col-span-1 row-span-1";               // 1x1 Compact
    case 2:
      return "col-span-1 row-span-1";               // 1x1 Compact
    case 3:
      return "col-span-1 row-span-1";               // 1x1 Compact
    case 4:
      return "col-span-1 sm:col-span-2 row-span-1"; // 2x1 Wide
    case 5:
      return "col-span-1 row-span-2";               // 1x2 Tall
    case 6:
      return "col-span-1 sm:col-span-2 row-span-1"; // 2x1 Wide
    case 7:
      return "col-span-1 row-span-1";               // 1x1 Compact
    case 8:
      return "col-span-1 row-span-1";               // 1x1 Compact
    default:
      return "col-span-1 row-span-1";
  }
};
---

<div class={`bento-gallery not-prose my-10 w-full ${className}`}>
  <!-- Bento Header Strip -->
  <div class="flex items-center justify-between pb-3 mb-4 border-b border-zinc-800">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-5 h-5 rounded-xs bg-lime-400 text-stone-950">
        <LayoutGrid size={12} className="text-stone-950" />
      </span>
      <h3 class="text-xs font-mono font-bold text-lime-400 uppercase tracking-wider m-0">
        / {title}
      </h3>
    </div>
    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider">
      {items.length} Figures &bull; Click to Enlarge
    </span>
  </div>

  {description && (
    <p class="text-xs text-zinc-400 font-sans -mt-2 mb-4 leading-relaxed">
      {description}
    </p>
  )}

  <!-- Bento Grid Container: strictly interlocking with zero overlapping -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 auto-rows-[190px] grid-flow-dense">
    {items.map((item, index) => {
      const spanClass = getBentoSpanClass(item, index);
      const isAstroImage = typeof item.src === "object" && "format" in item.src;
      const displayLabel = item.title || item.caption || item.alt;

      return (
        <div
          class={`bento-card group relative rounded-xl border border-zinc-800/80 bg-zinc-950/70 overflow-hidden cursor-zoom-in transition-all duration-300 hover:border-lime-400/50 hover:shadow-[0_8px_30px_rgba(0,0,0,0.8)] h-full w-full ${spanClass}`}
          data-full-src={item.fullSrc}
        >
          <!-- Confined Image Container -->
          <div class="w-full h-full overflow-hidden relative">
            {isAstroImage ? (
              <Image
                src={item.src as ImageMetadata}
                alt={item.alt || `Bento Image ${index + 1}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <img
                src={typeof item.src === "string" ? item.src : (item.src as any).src}
                alt={item.alt || `Bento Image ${index + 1}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            )}
          </div>

          <!-- Ambient Bottom Shadow Overlay -->
          <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-transparent opacity-75 group-hover:opacity-90 transition-opacity pointer-events-none" />

          <!-- Top Badge: Numbering -->
          <div class="absolute top-2.5 left-2.5 z-10 pointer-events-none">
            <span class="px-2 py-0.5 rounded-xs bg-black/80 backdrop-blur-md border border-white/10 font-mono text-[10px] text-lime-400 font-bold">
              #{String(index + 1).padStart(2, "0")}
            </span>
          </div>

          <!-- Top Right: Zoom Icon Affordance -->
          <div class="absolute top-2.5 right-2.5 z-10 p-1.5 rounded-full bg-black/60 text-zinc-400 group-hover:text-lime-400 opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-md pointer-events-none">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
          </div>

          <!-- Bottom Label -->
          {displayLabel && (
            <div class="absolute bottom-2.5 left-3 right-3 z-10 pointer-events-none">
              <p class="truncate font-mono text-xs text-zinc-200 group-hover:text-lime-300 transition-colors m-0 drop-shadow-md">
                {displayLabel}
              </p>
            </div>
          )}
        </div>
      );
    })}
  </div>
</div>
