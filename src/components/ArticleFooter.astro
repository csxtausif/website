---
import { Image } from "astro:assets";
import pfp from "@res/images/pfp.webp";
import github from "@res/images/icons/github.svg";
import linkedin from "@res/images/icons/linkedin.svg";
import twitter from "@res/images/icons/x.svg";
import { Sparkles, MessageSquare, ArrowLeft } from "lucide-react";

interface Props {
  currentTitle: string;
  type: "blog" | "project";
}

const { currentTitle, type = "blog" } = Astro.props;
---

<div class="article-footer mt-16 pt-10 border-t border-zinc-800 font-sans">
  <!-- My Hero Academia Completion Milestone Card -->
  <div
    class="completion-card relative overflow-hidden rounded-xl border border-lime-400/40 bg-zinc-950/80 p-6 sm:p-8 shadow-2xl mb-10"
  >
    <div
      class="absolute -right-12 -top-12 w-44 h-44 bg-lime-400/10 blur-3xl rounded-full pointer-events-none"
    >
    </div>

    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-lime-400 text-stone-950 font-mono font-extrabold text-xs tracking-wider">
            <Sparkles size={12} className="fill-stone-950 text-stone-950" />
            PLUS ULTRA!
          </span>
          <span class="text-xs font-mono text-zinc-400">
            Mission Complete
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-100 m-0 tracking-tight">
          You pushed past your limits and read to the end.
        </h3>
        <p class="text-sm text-zinc-400 mt-2 max-w-xl font-sans leading-relaxed m-0">
          A true hero never stops learning. As All Might would say: <em class="text-lime-300">"Now, it's your turn."</em> Take what you've learned and go build something impactful.
        </p>
      </div>

      <!-- Quick Action / Navigation -->
      <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 w-full sm:w-auto shrink-0">
        <a
          href={type === "blog" ? "/blog" : "/projects"}
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-lime-400 hover:bg-lime-300 text-stone-950 font-mono font-bold text-xs rounded-sm transition-colors text-center"
        >
          <ArrowLeft size={13} />
          <span>More {type === "blog" ? "Articles" : "Projects"}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Author Bio / About Section & Social Presence -->
  <div
    class="author-card flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6 p-6 rounded-lg bg-zinc-900/40 border border-zinc-800/80 mb-8"
  >
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 text-center sm:text-left">
      <Image
        src={pfp}
        alt="Tausif Alam"
        width={56}
        height={56}
        class="rounded-full border border-lime-400/40 shrink-0"
      />
      <div>
        <h4 class="text-base font-bold text-neutral-100 m-0">
          Written by Tausif Alam
        </h4>
        <p class="text-xs text-zinc-400 mt-1 max-w-md leading-relaxed m-0 font-sans">
          Software Engineer specializing in scalable backend systems, Node.js, and PostgreSQL. Curious explorer of systems and architecture.
        </p>
        <div class="flex items-center gap-4 mt-3 justify-center sm:justify-start">
          <a
            href="https://github.com/buildwithtausif"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-white transition-colors"
            title="GitHub"
          >
            <Image src={github} alt="GitHub" width={18} height={18} />
          </a>
          <a
            href="https://www.linkedin.com/in/buildwithtausif/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-white transition-colors"
            title="LinkedIn"
          >
            <Image src={linkedin} alt="LinkedIn" width={18} height={18} />
          </a>
          <a
            href="https://x.com/buildwithtausif"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-white transition-colors"
            title="Twitter / X"
          >
            <Image src={twitter} alt="Twitter" width={18} height={18} />
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Feedback / Email -->
    <a
      href={`mailto:connect.tausifalam@outlook.com?subject=Regarding: ${encodeURIComponent(currentTitle)}`}
      class="inline-flex items-center gap-2 text-xs font-mono text-zinc-400 hover:text-lime-400 border border-zinc-800 hover:border-lime-400/50 px-3.5 py-2 rounded-sm transition-colors text-center shrink-0 group"
    >
      <MessageSquare size={13} className="text-zinc-500 group-hover:text-lime-400 transition-colors" />
      <span>Send Thoughts / Feedback</span>
    </a>
  </div>
</div>
