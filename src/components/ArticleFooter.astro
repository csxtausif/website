---
import { Image } from "astro:assets";
import pfp from "@res/images/pfp.webp";
import github from "@res/images/icons/github.svg";
import linkedin from "@res/images/icons/linkedin.svg";
import twitter from "@res/images/icons/x.svg";
import { Sparkles, ArrowLeft } from "lucide-react";

interface Props {
  currentTitle: string;
  type: "blog" | "project";
}

const { currentTitle, type = "blog" } = Astro.props;
---

<div class="article-footer mt-10 pt-6 border-t border-zinc-800/80 font-sans">
  <!-- Milestone Completion Card (Compact) -->
  <div
    class="completion-card relative overflow-hidden rounded-lg border border-lime-400/30 bg-zinc-950/60 p-4 sm:p-5 mb-3 shadow-md"
  >
    <div
      class="absolute -right-8 -top-8 w-28 h-28 bg-lime-400/5 blur-2xl rounded-full pointer-events-none"
    >
    </div>

    <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-xs bg-lime-400 text-stone-950 font-mono font-bold text-[10px] tracking-wider uppercase">
            <Sparkles size={10} className="fill-stone-950 text-stone-950" />
            PLUS ULTRA // LOGS
          </span>
        </div>
        <h3 class="text-sm sm:text-base font-bold text-neutral-100 m-0 tracking-tight">
          Made it to the end.
        </h3>
        <p class="text-xs text-zinc-400 mt-1 max-w-xl font-sans leading-relaxed m-0">
          My corner of the internet is a rotating mix of system breakdowns, honest thoughts, and whatever I couldn't stop thinking about. If you liked this read, jump into the collection to see what else is brewing.
        </p>
      </div>

      <!-- Quick Action / Navigation -->
      <a
        href={type === "blog" ? "/blog" : "/projects"}
        class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-lime-400 hover:bg-lime-300 text-stone-950 font-mono font-bold text-xs rounded-sm transition-colors shrink-0 self-start sm:self-center"
      >
        <ArrowLeft size={12} />
        <span>More {type === "blog" ? "Articles" : "Projects"}</span>
      </a>
    </div>
  </div>

  <!-- Author Bio / About Widget (Sleek Compact Row) -->
  <div
    class="author-card p-3.5 sm:p-4 rounded-lg bg-zinc-900/30 border border-zinc-800/60"
  >
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
      <div class="flex items-start sm:items-center gap-3.5 min-w-0">
        <Image
          src={pfp}
          alt="Tausif Alam"
          width={42}
          height={42}
          class="rounded-full border-2 border-lime-400 shrink-0 shadow-[0_0_8px_rgba(163,230,53,0.25)] mt-0.5 sm:mt-0"
        />
        <div class="min-w-0">
          <h4 class="text-xs sm:text-sm font-bold text-neutral-100 m-0 whitespace-nowrap">
            Written by Tausif Alam
          </h4>
          <p class="text-[11px] sm:text-xs text-zinc-400 mt-0.5 leading-snug m-0 font-sans">
            Software Engineer &bull; Scalable backend systems, Node.js &amp; PostgreSQL
          </p>
        </div>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-3 shrink-0 self-end sm:self-center">
        <a
          href="https://github.com/buildwithtausif"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-white transition-colors p-1"
          title="GitHub"
        >
          <Image src={github} alt="GitHub" width={16} height={16} />
        </a>
        <a
          href="https://www.linkedin.com/in/buildwithtausif/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-white transition-colors p-1"
          title="LinkedIn"
        >
          <Image src={linkedin} alt="LinkedIn" width={16} height={16} />
        </a>
        <a
          href="https://x.com/buildwithtausif"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-white transition-colors p-1"
          title="Twitter / X"
        >
          <Image src={twitter} alt="Twitter" width={16} height={16} />
        </a>
      </div>
    </div>
  </div>
</div>
